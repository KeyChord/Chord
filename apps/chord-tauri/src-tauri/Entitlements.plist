<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Full-power profile: no App Sandbox, so native handlers (and shell/JS handlers) have the
        same authority as any other process of the user. Library validation stays enabled for the
        main process; only the chord-native-host sidecar disables it (see NativeHost.entitlements
        and configs/release/macos). For a sandboxed distribution use Entitlements.sandbox.plist
        via tauri.sandbox.conf.json; native handlers are unavailable there.
    -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
