<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Full-power profile: no App Sandbox, so package handlers (JavaScript, shell and native
        add-ons) have the same authority as any other process of the user.

        Library validation is off because packages' native add-ons load in this process and are
        signed by their authors, not by us: with it on, macOS refuses every one. Packages already
        run code here, so trusting what you install protects you either way. The rest of the
        hardened runtime stays on. For a sandboxed distribution use Entitlements.sandbox.plist
        via tauri.sandbox.conf.json; native handlers are unavailable there.
    -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
