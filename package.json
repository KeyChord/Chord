{
  "name": "@-/chord-monorepo",
  "version": "0.1.0-alpha.3",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "keychord/**"
    ]
  },
  "scripts": {
    "dev": "bun --filter keychord-tauri dev",
    "build": "bun --filter keychord-tauri build",
    "build-dmg": "bun --filter keychord-tauri build-dmg",
    "lint": "bun --filter keychord-tauri lint",
    "gen-types": "bun --filter keychord-tauri gen-types"
  },
  "dependencies": {
    "@keychord/com.npmjs.cmdk": "workspace:*",
    "@keychord/com.npmjs.date-fns": "workspace:*",
    "@keychord/com.npmjs.desm": "workspace:*",
    "@keychord/com.npmjs.map-obj": "workspace:*",
    "@keychord/com.npmjs.pathe": "workspace:*",
    "@keychord/com.npmjs.react-day-picker": "workspace:*",
    "@keychord/com.npmjs.react-resizable-panels": "workspace:*",
    "@keychord/com.npmjs.recharts": "workspace:*",
    "@keychord/com.npmjs.rename-fn": "workspace:*",
    "@keychord/com.npmjs.smol-toml": "workspace:*",
    "@keychord/com.npmjs.sonner": "workspace:*",
    "@keychord/com.npmjs.tanstack__devtools-client": "workspace:*",
    "@keychord/com.npmjs.tanstack__devtools-utils": "workspace:*",
    "@keychord/com.npmjs.tanstack__react-devtools": "workspace:*",
    "@keychord/com.npmjs.tanstack__react-query": "workspace:*",
    "@keychord/com.npmjs.tanstack__react-router": "workspace:*",
    "@keychord/com.npmjs.tanstack__react-router-devtools": "workspace:*",
    "@keychord/com.npmjs.tanstack__router-plugin": "workspace:*",
    "@keychord/com.npmjs.utils-cn": "workspace:*"
  },
  "devDependencies": {
    "vite-plus": "^0.1.13"
  },
  "overrides": {
    "@tanstack/devtools-client": "workspace:keychord/com/npmjs/tanstack__devtools-client",
    "@tanstack/devtools-utils": "workspace:keychord/com/npmjs/tanstack__devtools-utils",
    "@tanstack/react-devtools": "workspace:keychord/com/npmjs/tanstack__react-devtools",
    "@tanstack/react-query": "workspace:keychord/com/npmjs/tanstack__react-query",
    "@tanstack/react-router": "workspace:keychord/com/npmjs/tanstack__react-router",
    "@tanstack/react-router-devtools": "workspace:keychord/com/npmjs/tanstack__react-router-devtools",
    "@tanstack/router-plugin": "workspace:keychord/com/npmjs/tanstack__router-plugin"
  },
  "packageManager": "bun@1.3.11"
}
